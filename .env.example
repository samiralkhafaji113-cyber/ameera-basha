# Copy to .env.local (local) or add the same NAMES in Vercel → Settings → Environment Variables. NEVER commit real values.
# This file intentionally contains no secrets and no accounts.

# ── Public (safe for the browser) ─────────────────────────────────────────────────────────────────────────────────
# The public https origin of the site, no trailing slash. Production: your real domain. (Preview builds fall back to their
# own *.vercel.app address; local development uses http://localhost:3000 when this is empty.)
NEXT_PUBLIC_SITE_URL=
# Supabase → Project Settings → API → Project URL   (local stack: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → anon / publishable key (RLS protects the data; this key is not a secret)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OPERATOR ONLY: put these ONLY in a git-ignored file on your own computer (.env.local / .env.production.local) ──────
# Never add them to Vercel and never to Git. The website code (src/) does not read them.
# Used by: npm run db:seed | db:create-admin | db:audit | db:verify | db:backup | staff:audit and the integration tests.
SUPABASE_SERVICE_ROLE_KEY=

# Local integration tests only (accounts are created by `npm run db:create-admin` on the LOCAL stack). Leave empty otherwise.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=

# Optional: lower the number of parallel build workers on a low-memory machine / CI runner.
# NEXT_BUILD_CPUS=3
